{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aounmed.local/schemas/pdf-template-v1.schema.json",
  "title": "AounMED PDF Template V1",
  "type": "object",
  "required": ["schema_version", "document"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "pdf-template-v1"},
    "document": {
      "type": "object",
      "required": ["title", "week"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "week": {"type": "string", "minLength": 1},
        "subtitle": {"type": "string"},
        "output_name": {"type": "string", "pattern": "^[A-Za-z0-9._-]+\\.pdf$"},
        "closing_page": {"$ref": "#/$defs/closing_page"},
        "lectures": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/lecture_packet"}
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/section"},
          "description": "Deprecated flat form accepted for importing packets created before nested lectures. New packets must use lectures[].sections[]."
        }
      }
      ,
      "oneOf": [
        {"required": ["lectures"], "not": {"required": ["sections"]}},
        {"required": ["sections"], "not": {"required": ["lectures"]}}
      ]
    }
  },
  "$defs": {
    "closing_page": {
      "type": "object",
      "required": ["paragraphs", "signoff"],
      "additionalProperties": false,
      "properties": {
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "signoff": {"type": "string", "minLength": 1}
      }
    },
    "section": {
      "type": "object",
      "required": ["id", "title", "layout", "questions"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "title": {"type": "string", "minLength": 1},
        "lecture": {"$ref": "#/$defs/lecture"},
        "layout": {"enum": ["mcq_two_column", "seq_single_column", "explain_why"]},
        "hints": {
          "type": "array",
          "items": {"$ref": "#/$defs/hint"}
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/question"}
        }
      }
    },
    "lecture_packet": {
      "type": "object",
      "required": ["id", "title", "sections"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/section"}
        }
      }
    },
    "question": {
      "type": "object",
      "required": ["id", "number", "type", "stem"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "number": {"type": "integer", "minimum": 1},
        "type": {"enum": ["mcq", "multi_select", "seq", "ospe", "other", "explain_why"]},
        "case": {"type": "string"},
        "stem": {"type": "string", "minLength": 1},
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["label", "text"],
            "additionalProperties": false,
            "properties": {
              "label": {"type": "string", "pattern": "^[A-F]$"},
              "text": {"type": "string", "minLength": 1}
            }
          }
        },
        "answer": {"type": "string"},
        "correct_answers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-F]$"}
        },
        "explanation": {"type": "string"},
        "source_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "lecture_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/lecture_ref"}
        },
        "bank_source": {"$ref": "#/$defs/bank_source"},
        "notes": {
          "type": "array",
          "items": {"$ref": "#/$defs/note"}
        },
        "media": {
          "type": "array",
          "items": {"$ref": "#/$defs/media"}
        },
        "image": {"type": "string"},
        "caption": {"type": "string"}
      }
    },
    "lecture": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1}
      }
    },
    "lecture_ref": {
      "type": "object",
      "required": ["lecture_title", "slide_numbers"],
      "additionalProperties": false,
      "properties": {
        "lecture_id": {"type": "string", "minLength": 1},
        "lecture_title": {"type": "string", "minLength": 1},
        "slide_numbers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        }
      }
    },
    "bank_source": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "bank_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "question_number": {"type": ["integer", "string"]},
        "page_numbers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        }
      }
    },
    "note": {
      "type": "object",
      "required": ["kind", "text"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["note", "warning", "instruction", "source_limit"]},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "media": {
      "type": "object",
      "required": ["path", "alt_text"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "alt_text": {"type": "string", "minLength": 1},
        "caption": {"type": "string"}
      }
    },
    "hint": {
      "type": "object",
      "required": ["id", "text"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "text": {"type": "string", "minLength": 1},
        "source_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/lecture_ref"}
        }
      }
    }
  }
}
